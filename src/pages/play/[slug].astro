---
import { getCollection } from "astro:content";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects
    .filter((project) => project.data.play || project.data.demo)
    .map((project) => ({
      params: { slug: project.id },
      props: { project },
    }));
}

const { project } = Astro.props;
const { title, play, demo } = project.data;
const src = play ?? demo!;
const defaultMode = project.data.orientation === "portrait" ? "portrait" : "landscape";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>试玩 · {title} · {site.name}</title>
    <style>
      :root {
        color-scheme: light;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #1e2a2f;
        font-family: "Plus Jakarta Sans", system-ui, sans-serif;
      }
      .bar {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 14px;
        background: color-mix(in oklab, #1e2a2f 82%, transparent);
        backdrop-filter: blur(10px);
        color: #fffaf2;
      }
      .bar a {
        color: #7ec8bc;
        text-decoration: none;
        font-size: 13px;
        white-space: nowrap;
      }
      .bar a:hover {
        text-decoration: underline;
      }
      .title {
        font-size: 13px;
        opacity: 0.9;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .seg {
        display: flex;
        gap: 4px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 999px;
        padding: 3px;
      }
      .seg button {
        border: 0;
        background: transparent;
        color: #fffaf2;
        font-size: 12px;
        padding: 4px 10px;
        border-radius: 999px;
        cursor: pointer;
        opacity: 0.65;
        white-space: nowrap;
      }
      .seg button[aria-pressed="true"] {
        background: #7ec8bc;
        color: #1e2a2f;
        opacity: 1;
        font-weight: 600;
      }
      .stage {
        position: absolute;
        inset: 52px 0 0 0;
        display: grid;
        place-items: center;
        padding: 12px;
      }
      .phone {
        width: 100%;
        height: 100%;
      }
      .frame {
        width: 100%;
        height: 100%;
        border: 0;
        background: #000;
        border-radius: 12px;
        display: block;
      }
      /* 竖屏：手机框居中，高度撑满、宽度按 750x1624 反推，超出则按宽适配 */
      .stage[data-mode="portrait"] .phone {
        width: auto;
        height: 100%;
        max-width: 100%;
        aspect-ratio: 750 / 1624;
        padding: 10px;
        background: #0c1113;
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 28px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
      }
      .stage[data-mode="portrait"] .phone .frame {
        border-radius: 18px;
      }
      @media (max-aspect-ratio: 750/1624) {
        .stage[data-mode="portrait"] .phone {
          width: 100%;
          height: auto;
          max-height: 100%;
        }
      }
      /* 横屏：铺满 */
      .stage[data-mode="landscape"] {
        padding: 0;
      }
      .stage[data-mode="landscape"] .frame {
        border-radius: 0;
      }
      .tip {
        position: absolute;
        bottom: 10px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 11px;
        color: rgba(255, 250, 242, 0.55);
        background: rgba(0, 0, 0, 0.35);
        padding: 3px 10px;
        border-radius: 999px;
        pointer-events: none;
        white-space: nowrap;
      }
    </style>
  </head>
  <body>
    <div class="bar">
      <a href={`/projects/${project.id}/`}>← 返回介绍</a>
      <div class="title">{title}</div>
      <div style="display:flex;align-items:center;gap:10px">
        <div class="seg" data-seg>
          <button type="button" data-mode-btn="portrait" aria-pressed={defaultMode === "portrait" ? "true" : "false"}>竖屏</button>
          <button type="button" data-mode-btn="landscape" aria-pressed={defaultMode === "landscape" ? "true" : "false"}>横屏铺满</button>
        </div>
        <a href={src} target="_blank" rel="noreferrer">新窗口打开</a>
      </div>
    </div>
    <div class="stage" data-stage data-mode={defaultMode}>
      <div class="phone"><iframe class="frame" src={src} title={title} allow="fullscreen; autoplay; gamepad" allowfullscreen></iframe></div>
      <div class="tip" data-tip>竖屏游戏建议用竖屏模式，手机上效果最好</div>
    </div>
    <script>
      const stage = document.querySelector("[data-stage]");
      const seg = document.querySelector("[data-seg]");
      const tip = document.querySelector("[data-tip]");
      seg?.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-mode-btn]");
        if (!btn || !stage) return;
        const mode = btn.getAttribute("data-mode-btn");
        stage.setAttribute("data-mode", mode);
        seg.querySelectorAll("[data-mode-btn]").forEach((b) =>
          b.setAttribute("aria-pressed", b === btn ? "true" : "false"),
        );
        if (tip) tip.style.display = mode === "portrait" ? "" : "none";
      });
      if (stage && tip && stage.getAttribute("data-mode") !== "portrait") tip.style.display = "none";
    </script>
  </body>
</html>
