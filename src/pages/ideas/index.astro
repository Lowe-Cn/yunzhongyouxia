---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card.astro";
import { getWorkLabel } from "../../data/labels";

const ideas = (await getCollection("ideas")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="想法" description="学习与创作笔记">
  <section class="relative overflow-hidden border-b border-line/50">
    <div class="pointer-events-none absolute -left-16 top-8 h-56 w-56 rounded-full bg-warm/20 blur-3xl"></div>
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
      <p class="section-kicker" data-reveal>Journal</p>
      <h1
        class="mt-3 font-display text-4xl font-bold tracking-tight text-ink sm:text-6xl"
        data-reveal
        style="--reveal-delay: 60ms"
      >
        想法
      </h1>
      <p class="mt-4 max-w-2xl text-muted" data-reveal style="--reveal-delay: 120ms">
        随手记下的思考。新增一篇：在
        <code class="rounded bg-surface-2 px-1.5 py-0.5 font-mono text-xs">src/content/ideas/</code>
        新建 Markdown 文件。
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-10 sm:px-8 sm:py-14">
    <div class="grid gap-5 sm:grid-cols-2">
      {
        ideas.map((item, i) => (
          <div data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <Card
              title={item.data.title}
              summary={item.data.summary}
              href={`/ideas/${item.id}/`}
              label={getWorkLabel({ type: "idea" })}
              tags={item.data.tags}
              date={item.data.date}
            />
          </div>
        ))
      }
    </div>
  </section>
</Layout>
