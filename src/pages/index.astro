---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Marquee from "../components/Marquee.astro";
import { site } from "../data/site";
import { getWorkLabel } from "../data/labels";

const allProjects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featured = allProjects.filter((p) => p.data.featured).slice(0, 3);
const latestIdeas = (await getCollection("ideas"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<Layout description={site.tagline}>
  <!-- 全幅沉浸 Hero -->
  <section class="relative isolate min-h-[92vh] overflow-hidden bg-[#0c1216]">
    <div class="absolute inset-0 overflow-hidden bg-[radial-gradient(60%_80%_at_70%_20%,#1d3a38_0%,#0c1216_60%),radial-gradient(40%_50%_at_20%_80%,#2a2118_0%,transparent_70%)]">
      <img
        src="/images/hero-desk.jpg"
        alt=""
        data-hero-media
        class="hero-media absolute inset-0 h-[115%] w-full object-cover"
        fetchpriority="high"
        onerror="this.remove()"
      />
    </div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#0c1216]/92 via-[#0c1216]/62 to-[#0c1216]/28"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0c1216]/85 via-transparent to-[#0c1216]/35"></div>
    <div class="hero-noise absolute inset-0 opacity-[0.18]" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-a" aria-hidden="true"></div>
    <div class="hero-orb hero-orb-b" aria-hidden="true"></div>

    <div class="relative mx-auto flex min-h-[92vh] max-w-6xl flex-col justify-end px-5 pb-20 pt-28 sm:px-8 sm:pb-24">
      <p class="animate-rise font-mono text-[11px] tracking-[0.2em] text-[#8fd4c6] uppercase">
        Playable · Games · Notes · by {site.author}
      </p>

      <h1 class="hero-title mt-5 max-w-4xl font-display text-5xl font-extrabold leading-[0.92] tracking-tight text-[#fff9f1] sm:text-6xl lg:text-8xl">
        <span class="hero-title-line">{site.name}</span>
      </h1>

      <p class="animate-rise animate-rise-delay-2 mt-6 max-w-xl text-lg leading-relaxed text-white/78 sm:text-xl">
        {site.tagline} — 作者 {site.author}
      </p>

      <div class="animate-rise animate-rise-delay-3 mt-9 flex flex-wrap items-center gap-3">
        <a href="/projects/" class="btn-primary px-6 py-3 text-sm">浏览作品</a>
        <a
          href="/ideas/"
          class="btn-ghost border-white/20 bg-white/10 px-6 py-3 text-sm text-[#fff9f1] hover:bg-white/18"
        >
          看看想法
        </a>
      </div>
    </div>

    <a href="#selected" class="scroll-cue" aria-label="向下滚动">
      <span></span>
    </a>
  </section>

  <Marquee />

  <!-- 精选 -->
  <section id="selected" class="mx-auto max-w-6xl px-5 pt-16 sm:px-8 sm:pt-20">
    <div class="mb-10 flex items-end justify-between gap-4" data-reveal>
      <div>
        <p class="section-kicker">Selected</p>
        <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-ink sm:text-5xl">精选作品</h2>
        <p class="mt-3 max-w-xl text-sm text-muted sm:text-base">
          先把试玩广告这一类做精；其他类型会陆续补上。
        </p>
      </div>
      <a href="/projects/" class="hidden text-sm font-semibold text-accent transition hover:translate-x-0.5 hover:underline sm:inline">
        全部作品 →
      </a>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {
        featured.map((item, i) => (
          <div data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <Card
              title={item.data.title}
              summary={item.data.summary}
              href={`/projects/${item.id}/`}
              label={getWorkLabel({ type: item.data.type, category: item.data.category })}
              tags={item.data.tags}
              date={item.data.date}
              cover={item.data.cover}
            />
          </div>
        ))
      }
    </div>
  </section>

  <!-- 中间氛围条 -->
  <section class="relative mx-auto mt-20 max-w-6xl px-5 sm:px-8" data-reveal>
    <div class="showcase-banner overflow-hidden rounded-[1.8rem] border border-line/70">
      <img src="/images/texture-wash.png" alt="" class="absolute inset-0 h-full w-full object-cover opacity-50" onerror="this.remove()" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0c1216]/88 via-[#0c1216]/55 to-[#0c1216]/35"></div>
      <div class="relative grid gap-6 p-8 sm:grid-cols-[1.2fr_0.8fr] sm:p-10">
        <div>
          <p class="font-mono text-[11px] tracking-[0.18em] text-[#8fd4c6] uppercase">Craft mode</p>
          <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-[#fff9f1] sm:text-4xl">
            把能玩的东西，放到阳光下
          </h2>
          <p class="mt-3 max-w-lg text-sm leading-relaxed text-white/70">
            不只是截图墙。点进去，就能直接玩。
          </p>
        </div>
        <div class="flex items-end justify-start sm:justify-end">
          <a href="/projects/" class="btn-primary px-5 py-2.5 text-sm">立刻试玩 →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 想法 -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <div class="mb-10 flex items-end justify-between gap-4" data-reveal>
      <div>
        <p class="section-kicker">Journal</p>
        <h2 class="mt-2 font-display text-3xl font-bold tracking-tight text-ink sm:text-5xl">最近想法</h2>
        <p class="mt-3 text-sm text-muted sm:text-base">把做游戏路上的一点点思考留下来。</p>
      </div>
      <a href="/ideas/" class="hidden text-sm font-semibold text-accent transition hover:translate-x-0.5 hover:underline sm:inline">
        全部想法 →
      </a>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      {
        latestIdeas.map((item, i) => (
          <div data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <Card
              title={item.data.title}
              summary={item.data.summary}
              href={`/ideas/${item.id}/`}
              label={getWorkLabel({ type: "idea" })}
              tags={item.data.tags}
              date={item.data.date}
            />
          </div>
        ))
      }
    </div>
  </section>
</Layout>
