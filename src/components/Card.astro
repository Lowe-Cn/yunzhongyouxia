---
interface Props {
  title: string;
  summary: string;
  href: string;
  label?: string | null;
  tags?: string[];
  date?: Date;
  cover?: string;
}

const { title, summary, href, label = null, tags = [], date, cover } = Astro.props;
---

<a href={href} class="work-card group" data-spot>
  <div class="work-card-spot" aria-hidden="true"></div>

  {
    cover ? (
      <div class="relative aspect-[16/10] overflow-hidden bg-bg-deep">
        <img
          src={cover}
          alt=""
          class="h-full w-full object-cover transition duration-700 ease-out will-change-transform group-hover:scale-[1.06]"
          loading="lazy"
          onerror="this.closest('div').style.display='none'"
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/55 via-ink/10 to-transparent" />
        {label && (
          <span class="absolute left-4 top-4 rounded-full border border-white/20 bg-black/35 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.16em] text-[#faf6f0] backdrop-blur-md">
            {label}
          </span>
        )}
        <span class="absolute bottom-4 right-4 grid h-9 w-9 place-items-center rounded-full border border-white/25 bg-white/15 text-[#faf6f0] opacity-0 backdrop-blur-md transition duration-300 group-hover:opacity-100">
          →
        </span>
      </div>
    ) : (
      <div class="relative aspect-[16/10] overflow-hidden bg-[radial-gradient(circle_at_30%_20%,var(--accent-soft),transparent_50%),linear-gradient(145deg,var(--surface),var(--bg-deep))]">
        <div
          class="absolute inset-0 opacity-30"
          style="background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:24px 24px;"
        />
        {label && (
          <span class="absolute left-4 top-4 rounded-full bg-surface/90 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.16em] text-accent backdrop-blur-sm">
            {label}
          </span>
        )}
      </div>
    )
  }

  <div class="relative p-5 sm:p-6">
    <div class="mb-2 flex items-center justify-between gap-3">
      {
        date && (
          <time class="font-mono text-[11px] text-muted" datetime={date.toISOString()}>
            {date.toISOString().slice(0, 10)}
          </time>
        )
      }
    </div>
    <h3 class="font-display text-xl font-semibold tracking-tight text-ink transition duration-300 group-hover:text-accent">
      {title}
    </h3>
    <p class="mt-2 text-sm leading-relaxed text-muted">{summary}</p>
    {
      tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {tags.slice(0, 3).map((tag) => (
            <li class="rounded-full bg-bg-deep/80 px-2.5 py-0.5 font-mono text-[11px] text-muted">{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
</a>
