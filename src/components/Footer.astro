---
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="mt-8 border-t border-line/70">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-12 sm:flex-row sm:items-center sm:justify-between sm:px-8">
    <div>
      <p class="font-display text-sm font-semibold text-ink">{site.name} · {site.author}</p>
      <p class="mt-1 font-mono text-xs text-muted">© {year} · 试玩广告 · 游戏 · 想法</p>
    </div>
    <div class="flex gap-5 text-sm text-muted">
      {
        site.social.github && (
          <a class="transition hover:text-accent" href={site.social.github} target="_blank" rel="noreferrer">
            GitHub
          </a>
        )
      }
      {
        site.social.bilibili && (
          <a class="transition hover:text-accent" href={site.social.bilibili} target="_blank" rel="noreferrer">
            哔哩哔哩
          </a>
        )
      }
      {
        site.email && (
          <a class="transition hover:text-accent" href={`mailto:${site.email}`}>
            邮箱
          </a>
        )
      }
    </div>
  </div>
</footer>
